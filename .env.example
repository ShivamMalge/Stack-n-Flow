# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real credentials.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/stacknflow"

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Signs the NextAuth session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Base URL of the deployment. Optional on Vercel, required locally.
NEXTAUTH_URL="http://localhost:3000"
